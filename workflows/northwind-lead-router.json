    {
      "parameters": {
        "jsCode": "const lead = $('NormalizeLead').item.json;\nconst enrich = $json;\nconst enrichCompany = enrich.company?.name || '';\nlet score = 0;\nif ((lead.formIntent || '').toLowerCase().includes('quote')) score += 40;\nif (lead.phone) score += 25;\nif (enrichCompany.length > 3) score += 20;\nif (lead.email) score += 15;\nconst tier = score >= 70 ? 'hot' : score >= 40 ? 'warm' : 'cold';\nreturn [{ json: { ...lead, enrichCompany, score, tier } }];"
      },
